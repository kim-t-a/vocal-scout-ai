# Copy this file to .env and fill in your keys. NEVER commit .env.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# Required: https://build.nvidia.com  (chat + embeddings via NVIDIA NIM)
NVIDIA_API_KEY=nvapi-...

# Required: https://www.assemblyai.com  (audio transcription)
ASSEMBLYAI_API_KEY=...

# Optional: comma-separated list of allowed frontend origins.
# Leave unset for local dev (any origin allowed).
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com
